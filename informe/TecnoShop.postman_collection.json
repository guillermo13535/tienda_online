{
  "info": {
    "name": "TecnoShop API",
    "description": "Colección de pruebas de la API REST de TecnoShop. Base URL: http://localhost:3000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. GET Productos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base}}/api/products", "host": ["{{base}}"], "path": ["api", "products"] }
      }
    },
    {
      "name": "2. POST Registro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Ana\",\n  \"email\": \"ana@test.cl\",\n  \"password\": \"123456\"\n}" },
        "url": { "raw": "{{base}}/api/auth/register", "host": ["{{base}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "3. POST Login (admin)",
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["var d = pm.response.json();", "if (d.token) pm.collectionVariables.set('token', d.token);", "pm.test('200 OK', function(){ pm.response.to.have.status(200); });"] }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@tecnoshop.cl\",\n  \"password\": \"admin123\"\n}" },
        "url": { "raw": "{{base}}/api/auth/login", "host": ["{{base}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "4. POST Crear pedido (con token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"id\": 14, \"qty\": 2 }],\n  \"metodo\": \"Tarjeta\"\n}" },
        "url": { "raw": "{{base}}/api/orders", "host": ["{{base}}"], "path": ["api", "orders"] }
      }
    },
    {
      "name": "5. GET Mis pedidos (con token)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base}}/api/orders", "host": ["{{base}}"], "path": ["api", "orders"] }
      }
    },
    {
      "name": "6. POST Preferencia Mercado Pago",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"id\": 1, \"qty\": 1 }]\n}" },
        "url": { "raw": "{{base}}/api/pago/preferencia", "host": ["{{base}}"], "path": ["api", "pago", "preferencia"] }
      }
    }
  ]
}
